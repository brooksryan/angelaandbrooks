# Google Sheets RSVP backend
# The Sheet ID is the long token in the Google Sheets URL after /d/
GOOGLE_SHEETS_ID=

# Service account JSON key (base64-encoded so it survives Cloudflare's env-var
# input). Generate locally with: base64 -i path/to/service-account.json | pbcopy
GOOGLE_SERVICE_ACCOUNT_KEY=

# Admin dashboard credentials. Two pairs so Brooks and Angela have independent
# access; the dashboard accepts either pair.
ADMIN_USER_1=
ADMIN_PASS_1=
ADMIN_USER_2=
ADMIN_PASS_2=
