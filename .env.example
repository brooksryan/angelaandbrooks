# Google Sheets RSVP backend
# The Sheet ID is the long token in the Google Sheets URL after /d/
GOOGLE_SHEETS_ID=

# The tab/sheet name within the spreadsheet that RSVPs are written to / read
# from (case-sensitive, lowercase per Brooks's setup).
GOOGLE_SHEET_TAB=rsvps

# The Guest List tab (the `official-guest-list` allowlist the name gate matches
# against). Accepts either the tab's stable numeric gid (the number after #gid=
# in the sheet URL — rename-proof, preferred) or the literal tab name. Same
# spreadsheet as GOOGLE_SHEETS_ID.
GOOGLE_SHEET_TAB_OFFICIAL_GUEST_LIST=

# The plus-one names reference tab (`plus_one_names`). The RSVP writer appends
# one row per named +1 here: timestamp, party_id, host_guest_id, host_name,
# plus_one_name, plus_one_guest_id. Same spreadsheet as GOOGLE_SHEETS_ID, same
# resolution as the other tab vars — accepts the tab's stable numeric gid
# (rename-proof, preferred) or the literal tab name.
GOOGLE_SHEET_TAB_PLUS_ONE_NAMES=plus_one_names

# Service account JSON key (base64-encoded so it survives Cloudflare's env-var
# input). Generate locally with: base64 -i path/to/service-account.json | pbcopy
GOOGLE_SERVICE_ACCOUNT_KEY=

# Admin dashboard credential — single shared login for Brooks and Angela.
ADMIN_USER_1=
ADMIN_PASS_1=

# Guest gate signing secret. Signs the ~90-day access cookie the name screen
# issues; keep it long and random (e.g. `openssl rand -base64 32`). Rotating it
# invalidates every existing guest access cookie. Separate from the admin login
# so the two auth systems never share a key.
GATE_SECRET=
