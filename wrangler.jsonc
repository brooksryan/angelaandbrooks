{
  // Cloudflare Workers config (replaces the previous Pages config). The site
  // runs as a single Worker with static assets bundled in via the assets
  // binding. Generated by `pnpm cf:build` using @opennextjs/cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angelaandbrooks",
  // Pinning account_id explicitly so wrangler doesn't try to auto-discover it
  // via the user-level token endpoints, which 401 against our account-scoped
  // CI token. Account IDs aren't secret — this is fine to commit.
  "account_id": "8b02e6c0c3ab72f486d83a89a06c2c3d",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
