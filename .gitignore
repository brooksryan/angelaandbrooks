# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# Override the user's global gitignore — this repo commits the pnpm lockfile
# so Cloudflare CI gets reproducible builds.
!pnpm-lock.yaml
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values live in Cloudflare Pages env vars, never the repo.
# .env.example is the documented template and IS committed.
.env*
!.env.example

# cloudflare workers / wrangler / opennextjs build output
.wrangler
.dev.vars
.open-next

# legacy vercel output dir (kept for safety in case anything still emits it)
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# service account keys — never commit
*service-account*.json
*-credentials.json
# Google Cloud service-account JSON keys (project-<hash>.json form)
wedding-site-*.json
gcp-*.json

# to-execution per-session progress records (defense-in-depth; .excn/.gitignore also covers these)
*_progress.json

# oversized hero asset deferred in Sprint 1 — 28MB exceeds Cloudflare's 25MB limit.
# Sprint 2 optimizes it under the limit; drop this rule once the optimized file lands.
/public/hero.jpg

# stray scratch file, not a site artifact
/raw_conference_panel.html

# Guest-list data dumps — contain real guest names (PII). This is a PUBLIC repo;
# never commit the generated lists. The .mjs tooling in scripts/ is PII-free and may be committed.
/scripts/guest-list-preview.tsv
/scripts/guest-list-review.md
/scripts/*.tsv
/scripts/*-guests*.json
